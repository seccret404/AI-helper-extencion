{
  "manifest_version": 3,
  "name": "AI Helper",
  "version": "1.0.0",
  "description": "Select text, get an answer.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://ollama.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Helper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
